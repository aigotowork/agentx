{
  "name": "agentx-plugin-typecheck",
  "private": true,
  "description": "Type-checks the embedded agent plugins against their upstream SDK types.",
  "engines": {
    "node": ">=22.23.3 <23"
  },
  "packageManager": "npm@10.9.9",
  "scripts": {
    "audit:dependencies": "npm audit --package-lock-only --include=dev --audit-level=low",
    "typecheck": "tsc --noEmit",
    "test:dependencies": "node --test tests/dependency_compatibility.test.mjs",
    "test:plugins": "node --experimental-strip-types --experimental-test-module-mocks --test tests/plugin_delivery.test.ts",
    "typecheck:workbench": "tsc -p web/workbench/tsconfig.json --noEmit",
    "build:workbench": "node web/workbench/build.mjs",
    "test:workbench": "node --experimental-strip-types --test web/workbench/tests/state.test.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@kilocode/plugin": "7.8.8",
    "@oh-my-pi/pi-coding-agent": "18.10.2",
    "@opencode-ai/plugin": "1.19.0",
    "@opencode-ai/sdk": "1.19.0",
    "@opencode/plugin": "2.0.27",
    "@types/bun": "1.4.3",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vite": "8.3.7",
    "@vitejs/plugin-react": "6.3.0",
    "@rolldown/binding-wasm32-wasi": "1.2.18"
  },
  "overrides": {
    "vite@8.3.7": {
      "rolldown": "1.2.18"
    },
    "glob@>=13.0.0 <14.0.2": "14.0.4",
    "minimatch@>=10.0.0 <11.0.1": "11.0.5",
    "toml@>=4.0.0 <5.0.1": "5.0.1",
    "undici@>=6.0.0 <6.29.1": "6.29.1",
    "undici@>=8.0.0 <8.12.2": "8.12.4",
    "zod@>=4.0.0 <4.6.6": "4.6.7",
    "puppeteer-core@>=25.0.0 <25.13.0": "25.16.0",
    "onnxruntime-node": {
      "global-agent": "4.1.3"
    },
    "js-yaml": "4.3.2"
  },
  "dependencies": {
    "@agentx/client": "file:packages/agentx-client"
  }
}
