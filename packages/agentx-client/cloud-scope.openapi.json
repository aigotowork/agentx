        },
        "required": [
          "operation"
        ],
        "type": "object"
      },
      "ControlReceipt": {
        "properties": {
          "claim_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "command": {
            "$ref": "#/components/schemas/ControlCommand"
          },
          "generation": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "installation_id": {
            "type": "string"
          },
          "outcome": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ControlOutcome"
              }
            ]
          },
          "request_id": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ControlStatus"
          }
        },
        "required": [
          "generation",
          "request_id",
          "host",
          "installation_id",
          "command",
          "status",
          "claim_id",
          "outcome"
        ],
        "type": "object"
      },
      "ControlStatus": {
        "enum": [
          "queued",
          "running",
          "succeeded",
          "failed",
          "uncertain"
        ],
        "type": "string"
      },
      "Descriptor": {
        "properties": {
          "generation": {
            "type": "string"
          },
          "protocol_version": {
            "format": "u-int32",
            "minimum": 0,
            "type": "integer"
          },
          "scope_id": {
            "type": "string"
          }
        },
        "required": [
          "scope_id",
          "generation",
          "protocol_version"
        ],
        "type": "object"
      },
      "HostCapabilities": {
        "properties": {
