        },
        "required": [
          "generation",
          "installation_id",
          "agent",
          "claim_id",
          "message_ids"
        ],
        "type": "object"
      },
      "ControlCommand": {
        "oneOf": [
          {
            "properties": {
              "initial_prompt": {
                "maxLength": 16384,
                "type": [
                  "string",
                  "null"
                ]
              },
              "kind": {
                "enum": [
                  "launch"
                ],
                "type": "string"
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "role": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "workspace": {
                "type": "string"
              }
            },
            "required": [
              "workspace",
              "kind"
            ],
            "type": "object"
          },
          {
            "properties": {
              "incarnation": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "stop"
                ],
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "incarnation",
              "kind"
            ],
            "type": "object"
          }
        ]
      },
      "ControlOutcome": {
        "oneOf": [
          {
            "properties": {
              "agent": {
                "$ref": "#/components/schemas/AgentView"
              },
              "status": {
                "enum": [
                  "succeeded"
                ],
                "type": "string"
              }
            },
            "required": [
              "agent",
              "status"
            ],
            "type": "object"
          },
          {
            "properties": {
              "code": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "failed"
                ],
                "type": "string"
              }
            },
            "required": [
              "code",
              "status"
            ],
            "type": "object"
          },
          {
            "properties": {
              "code": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "uncertain"
                ],
                "type": "string"
              }
            },
            "required": [
              "code",
              "status"
            ],
            "type": "object"
          }
        ]
      },
      "ControlPoll": {
        "properties": {
          "operation": {
            "oneOf": [
              {
                "type": "null"
