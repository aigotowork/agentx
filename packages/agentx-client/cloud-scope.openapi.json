          "host": {
            "type": "string"
          },
          "incarnation": {
            "type": "string"
          },
          "installation_id": {
            "type": "string"
          }
        },
        "required": [
          "generation",
          "installation_id",
          "host",
          "incarnation"
        ],
        "type": "object"
      },
      "AgentView": {
        "additionalProperties": false,
