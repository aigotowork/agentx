{
  "components": {
    "schemas": {
      "AgentPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AgentView"
            },
            "type": "array"
          },
          "next": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "next"
