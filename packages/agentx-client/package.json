{
  "name": "@agentx/client",
  "version": "0.1.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "Browser-safe AgentX HTTP client and separate Node HTTP CLI",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agentx-http": "./dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "AGENTS.md",
    "management.openapi.json",
    "workbench.openapi.json",
    "observation.openapi.json",
    "cloud-admin.openapi.json",
    "cloud-namespace.openapi.json"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "node scripts/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "lossless-json": "4.3.3"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
