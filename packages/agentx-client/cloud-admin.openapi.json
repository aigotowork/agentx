            "minimum": 0,
            "type": "integer"
          },
          "protocol_version": {
            "format": "u-int32",
            "minimum": 0,
            "type": "integer"
          },
          "scopes": {
            "format": "u-int32",
            "minimum": 0,
            "type": "integer"
          },
          "unavailable": {
            "format": "u-int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "deployment_id",
          "protocol_version",
          "observed_at",
          "scopes",
          "hosts",
          "online_hosts",
          "agents",
          "unavailable"
